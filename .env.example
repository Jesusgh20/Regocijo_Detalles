# Copia este archivo como ".env" (que NO se sube a git) y completa los valores.
# En Vercel: Project → Settings → Environment Variables (las mismas dos).
# Pasos completos en SUPABASE.md.

# Supabase → Project Settings → API → "Project URL"
NUXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Supabase → Project Settings → API → "anon public" (¡NUNCA pongas aquí la clave "service_role"!)
NUXT_PUBLIC_SUPABASE_ANON_KEY=

# Dirección pública del sitio (para las imágenes al compartir)
NUXT_PUBLIC_SITE_URL=https://tu-dominio.com
